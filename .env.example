ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Filled in by `python setup_agent.py` on its first run.
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=

# Who can sign in: comma-separated name:key pairs, one per person or team. Keys must be at
# least 24 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Remove a pair and restart to revoke that key.
APP_ACCESS_KEYS=aman:replace-with-a-generated-key,ops-team:replace-with-another-key
# Signs conversation references so users can't open each other's chats. At least 32
# characters; generate it the same way. Changing it ends all open conversations.
APP_SECRET=replace-with-a-generated-secret

# Optional limits (defaults shown).
RATE_LIMIT_PER_HOUR=30
MAX_CONCURRENT_REPLIES=8
REPLY_TIMEOUT_SECONDS=300

# Optional: where `python run_backend.py` listens locally. In Docker, set PORT only.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Docker only: IP of your load balancer or reverse proxy, so https and client IPs are seen correctly.
# FORWARDED_ALLOW_IPS=10.0.0.5
